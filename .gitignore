# Environment / secrets — never commit real credentials
.env
.env.local
backend/.env

# PHP (composer is dev-only, for PHPUnit — see backend/composer.json;
# composer.lock IS committed for reproducible test installs, vendor/ is not)
backend/vendor/
backend/.phpunit.result.cache

# Uploaded media (git-ignored; folders kept via .gitkeep)
backend/api/uploads/*
!backend/api/uploads/.gitkeep

# Rate-limiter state (file-based, regenerates automatically) — but keep
# the protective .htaccess that denies direct web access to this folder
backend/storage/*
!backend/storage/.htaccess

# OS / editor
.DS_Store
*.swp
