# Copy this file to .env at the project root (same level as /backend and
# /frontend) and fill in real values. Never commit the real .env file.

# --- Application URLs ---
APP_ENV=development
# Public URL of the React frontend (used for CORS origin checks in dev)
APP_URL=http://localhost:5173
# Public URL of the PHP API (used by the sitemap generator to build absolute URLs)
API_URL=http://localhost/api

# --- Database (MySQL / MariaDB) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=giisindia
DB_USER=giisindia_user
DB_PASSWORD=change-me

# --- CORS ---
# Comma-separated list of origins allowed to call the API with credentials.
# Only needed in local development, where the Vite dev server (5173) and the
# PHP API run on different ports. In production, the built frontend and the
# API are served from the same origin, so this is not required.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Session / security ---
SESSION_NAME=giisindia_session
# Any long random string, generated once per environment — never reuse across environments.
SESSION_SECRET=change-me-to-a-long-random-string
